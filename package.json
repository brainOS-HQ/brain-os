{
  "name": "brain-os",
  "version": "0.9.2",
  "description": "Local-first MCP memory server for operational project state: decisions, blockers, plans, patterns, and next moves. The persistent memory layer that stops agent amnesia.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "brain-os": "bin/brain-os.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "serve": "node dist/index.js",
    "test": "npm run build && node --test tests/smoke.mjs",
    "privacy-scan": "node scripts/privacy-scan.mjs --git",
    "prepublishOnly": "npm run build && node scripts/privacy-scan.mjs --pack",
    "metrics": "node scripts/fetch-metrics.mjs"
  },
  "keywords": [
    "brain os",
    "mcp",
    "model-context-protocol",
    "mcp server",
    "local-first mcp server",
    "persistent memory layer",
    "operational memory",
    "operational state for agents",
    "project memory",
    "project state",
    "agent memory",
    "memory that stops agent amnesia",
    "persistent memory for ai",
    "ai agents",
    "claude code",
    "cursor",
    "local-first",
    "developer tools"
  ],
  "author": "Tasha Amanda",
  "homepage": "https://brainos-hq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainOS-HQ/brain-os.git"
  },
  "bugs": {
    "url": "https://github.com/brainOS-HQ/brain-os/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "peerDependencies": {
    "openai": "^6.35.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "hono": "^4.12.34",
    "express-rate-limit": ">=8.5.1",
    "ip-address": "^10.4.0",
    "qs": ">=6.15.2"
  },
  "engines": {
    "node": ">=20"
  }
}
